generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  RECEPTIONIST
  CAFE_STAFF
}

enum BookingStatus {
  PENDING
  RESERVED
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  EXPIRED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentGateway {
  RAZORPAY
  CASH
  CARD
  UPI
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          UserRole  @default(RECEPTIONIST)
  phone         String?
  avatar        String?
  isActive      Boolean   @default(true)
  refreshToken  String?
  lockoutUntil  DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings      Booking[]
  activityLogs  ActivityLog[]
}

model Guest {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  idProof   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings  Booking[]
  profile   GuestProfile?
}

model Cottage {
  id            String   @id @default(cuid())
  propertyId    String?
  name          String
  slug          String   @unique
  description   String
  shortDesc     String?
  pricePerNight Int
  capacity      Int      @default(2)
  extraGuestCharge Int   @default(1500)
  bedrooms      Int      @default(1)
  bathrooms     Int      @default(1)
  size          Int?
  category      String?
  amenities     Json     @default("[]")
  images        Json     @default("[]")
  heaterCharge  Int      @default(600)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property      Property? @relation(fields: [propertyId], references: [id])
  bookings      Booking[]
  blockedDates  BlockedDate[]
  seasonalPricings SeasonalPricing[]
  reviews       Review[]
}

model SeasonalPricing {
  id          String   @id @default(cuid())
  cottageId   String
  name        String
  startDate   DateTime
  endDate     DateTime
  pricePerNight Int
  minStay     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  cottage     Cottage  @relation(fields: [cottageId], references: [id], onDelete: Cascade)

  @@index([cottageId])
}

enum StaffStatus {
  ACTIVE
  FIRED
}

model Staff {
  id            String      @id @default(cuid())
  propertyId    String?
  name          String
  phone         String
  employeeId    String      @unique
  role          String      @default("Staff")
  salary        Int?
  address       String?
  photo         String?
  status        StaffStatus @default(ACTIVE)
  hiredAt       DateTime    @default(now())
  firedAt       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  property      Property?   @relation(fields: [propertyId], references: [id])
  shifts        StaffShift[]
  attendance    StaffAttendance[]
}

model Package {
  id          String    @id @default(cuid())
  title       String
  description String?
  image       String?
  link        String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BlockedDate {
  id        String   @id @default(cuid())
  cottageId String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  cottage   Cottage  @relation(fields: [cottageId], references: [id], onDelete: Cascade)

  @@unique([cottageId, date])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String?
  discountType  String   @default("PERCENTAGE")
  discountValue Float
  minAmount     Float    @default(0)
  maxUsage      Int      @default(0)
  usedCount     Int      @default(0)
  maxUsesPerUser Int      @default(1)
  voucherType    String   @default("BOTH")
  isActive      Boolean  @default(true)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  usages        CouponUsage[]
}

model CouponUsage {
  id         String   @id @default(cuid())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId   String
  userId     String
  bookingId  String?
  createdAt  DateTime @default(now())

  @@index([couponId, userId])
}

model Booking {
  id              String         @id @default(cuid())
  propertyId      String?
  bookingRef      String         @unique
  guestId         String
  cottageId       String
  userId          String?
  checkIn         DateTime
  checkOut        DateTime
  adults          Int            @default(2)
  children        Int            @default(0)
  totalAmount     Float
  discount        Float          @default(0)
  couponCode      String?
  finalAmount     Float
  status          BookingStatus  @default(PENDING)
  holdExpiresAt   DateTime?
  paymentStatus   PaymentStatus  @default(PENDING)
  paymentId       String?
  paymentGateway  PaymentGateway?
  specialRequests String?
  source          String         @default("WEBSITE")
  notes           String?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  property        Property?      @relation(fields: [propertyId], references: [id])
  guest           Guest          @relation(fields: [guestId], references: [id])
  cottage         Cottage        @relation(fields: [cottageId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])
  payment         Payment?
  reviews         Review[]

  @@index([guestId])
  @@index([cottageId])
  @@index([status])
  @@index([status, holdExpiresAt])
  @@index([checkIn, checkOut])
  @@index([createdAt])
}

model Payment {
  id            String         @id @default(cuid())
  bookingId     String         @unique
  orderId       String?
  paymentId     String?
  signature     String?
  amount        Float
  currency      String         @default("INR")
  status        PaymentStatus  @default(PENDING)
  gateway       PaymentGateway @default(RAZORPAY)
  method        String?
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model CafeCategory {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  image       String?
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       CafeItem[]
}

model CafeItem {
  id            String        @id @default(cuid())
  categoryId    String
  name          String
  description   String?
  price         Float
  image         String?
  isAvailable   Boolean       @default(true)
  isVegetarian  Boolean       @default(true)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category      CafeCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems    CafeOrderItem[]
}

model CafeOrder {
  id            String        @id @default(cuid())
  orderRef      String        @unique
  tableNumber   Int
  guestName     String?
  notes         String?
  status        OrderStatus   @default(PENDING)
  totalAmount   Float
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?
  paymentMethod String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         CafeOrderItem[]

  @@index([status])
  @@index([createdAt])
}

model CafeOrderItem {
  id          String      @id @default(cuid())
  orderId     String
  itemId      String
  quantity    Int         @default(1)
  unitPrice   Float
  totalPrice  Float
  notes       String?

  order       CafeOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item        CafeItem    @relation(fields: [itemId], references: [id])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  email     String?
  content   String
  rating    Int      @default(5)
  image     String?
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  replySent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Gallery {
  id        String   @id @default(cuid())
  image     String
  caption   String?
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ChatSenderType {
  GUEST
  ADMIN
}

enum ChatConversationStatus {
  ACTIVE
  CLOSED
}

model ChatConversation {
  id        String                @id @default(cuid())
  guestName String
  guestEmail String?
  guestPhone String?
  status    ChatConversationStatus @default(ACTIVE)
  socketId  String?
  assignedTo String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  messages  ChatMessage[]
}

model ChatMessage {
  id              String          @id @default(cuid())
  conversationId  String
  senderType      ChatSenderType
  senderId        String?
  senderName      String?
  content         String
  createdAt       DateTime        @default(now())

  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// SaaS FEATURES - Multi-Property, CRM, Loyalty, etc.
// ==========================================

model Property {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  address     String?
  phone       String?
  email       String?
  timezone    String   @default("Asia/Kolkata")
  currency    String   @default("INR")
  logo        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cottages    Cottage[]
  staff       Staff[]
  bookings    Booking[]
}

// Enhanced Guest CRM
model GuestProfile {
  id              String   @id @default(cuid())
  guestId         String   @unique
  dateOfBirth     DateTime?
  nationality     String?
  language        String   @default("en")
  idType          String?
  idNumber        String?
  emergencyContact String?
  emergencyPhone  String?
  preferences     Json     @default("{}")
  dietaryRestrictions String?
  specialDates    Json     @default("[]")
  notes           String?
  totalStays      Int      @default(0)
  totalSpent      Float    @default(0)
  loyaltyPoints   Int      @default(0)
  tier            String   @default("BRONZE")
  referredBy      String?
  referralCode    String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guest           Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reviews         Review[]
  loyaltyTransactions LoyaltyTransaction[]
}

model Review {
  id          String   @id @default(cuid())
  guestId     String
  bookingId   String?
  cottageId   String?
  rating      Int
  title       String?
  content     String?
  pros        String?
  cons        String?
  source      String   @default("WEBSITE")
  isVerified  Boolean  @default(false)
  isVisible   Boolean  @default(true)
  adminReply  String?
  repliedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guestProfile GuestProfile @relation(fields: [guestId], references: [guestId])
  booking      Booking?     @relation(fields: [bookingId], references: [id])
  cottage      Cottage?     @relation(fields: [cottageId], references: [id])

  @@index([guestId])
  @@index([cottageId])
  @@index([isVisible])
}

// Loyalty & Referral Program
model LoyaltyTransaction {
  id          String   @id @default(cuid())
  guestId     String
  points      Int
  type        String
  description String?
  bookingId   String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  guestProfile GuestProfile @relation(fields: [guestId], references: [guestId])

  @@index([guestId])
}

model Referral {
  id            String   @id @default(cuid())
  referrerCode  String
  refereeEmail  String
  refereeName   String?
  status        String   @default("PENDING")
  rewardPoints  Int      @default(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([referrerCode])
  @@index([refereeEmail])
}

// Dynamic Pricing
model PricingRule {
  id            String   @id @default(cuid())
  name          String
  type          String
  dayOfWeek     Int?
  startDate     DateTime?
  endDate       DateTime?
  multiplier    Float    @default(1.0)
  minStay       Int?
  maxStay       Int?
  isActive      Boolean  @default(true)
  priority      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type, isActive])
}

// Staff Scheduling
model StaffShift {
  id          String   @id @default(cuid())
  staffId     String
  date        DateTime
  startTime   String
  endTime     String
  shiftType   String   @default("DAY")
  status      String   @default("SCHEDULED")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
}

model StaffAttendance {
  id          String   @id @default(cuid())
  staffId     String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      String   @default("PRESENT")
  hoursWorked Float?
  overtime    Float?   @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
  @@unique([staffId, date])
}

// Cafe Inventory
model CafeInventory {
  id            String   @id @default(cuid())
  name          String
  category      String
  quantity      Float    @default(0)
  unit          String   @default("kg")
  minStock      Float    @default(10)
  maxStock      Float?
  costPerUnit   Float?
  supplier      String?
  lastRestocked DateTime?
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  logs          CafeInventoryLog[]

  @@index([category, isActive])
}

model CafeInventoryLog {
  id            String   @id @default(cuid())
  inventoryId   String
  type          String
  quantity      Float
  reason        String?
  performedBy   String?
  createdAt     DateTime @default(now())

  inventory     CafeInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, createdAt])
}

// Webhook System
model Webhook {
  id          String   @id @default(cuid())
  url         String
  events      Json
  secret      String?
  isActive    Boolean  @default(true)
  lastTriggered DateTime?
  failCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries  WebhookDelivery[]
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  webhookId   String
  event       String
  payload     Json
  response    Json?
  statusCode  Int?
  success     Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  deliveredAt DateTime?

  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

// Document Management
model Document {
  id          String   @id @default(cuid())
  name        String
  category    String
  fileUrl     String
  fileType    String
  fileSize    Int?
  description String?
  expiresAt   DateTime?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// Server-Side Notifications
model Notification {
  id          String   @id @default(cuid())
  userId      String?
  type        String
  title       String
  message     String
  data        Json?
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}
