# ============================================
# VEDARA RETREAT BACKEND — ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development
COOKIE_SECRET=change-this-to-a-random-64-char-string

# --- Admin Seed (REQUIRED for `npm run seed`) ---
# Minimum 8 characters. No default is used; seeding fails if this is missing/weak.
ADMIN_PASSWORD=change-this-admin-password-min-8-chars

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/vedara"

# --- JWT ---
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Payment Gateway (Razorpay) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=   <-- LOAD FROM SECRET MANAGER, NOT .ENV IN PROD

# --- Cloudinary (Image Upload) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=     <-- LOAD FROM SECRET MANAGER
# CLOUDINARY_API_SECRET=  <-- LOAD FROM SECRET MANAGER

# --- Email (Nodemailer SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# SMTP_PASS=             <-- USE APP PASSWORD, STORE SECURELY
EMAIL_FROM=noreply@vedara.com
ADMIN_EMAIL=vedararetreat@gmail.com

# --- AI / Chatbot ---
# GROQ_API_KEY=          <-- LOAD FROM SECRET MANAGER

# --- WhatsApp (WATI API) ---
WHATSAPP_API_URL=https://live-mt-server.wati.io
# WHATSAPP_API_KEY=      <-- LOAD FROM SECRET MANAGER
WHATSAPP_TO_NUMBER=919118882242
ADMIN_PHONE=919118882242

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:3000

# --- Booking ---
BOOKING_HOLD_MINUTES=15
